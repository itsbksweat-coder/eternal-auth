DISCORD_PUBLIC_KEY=your_discord_application_public_key
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_APPLICATION_ID=your_discord_application_id
DISCORD_CLIENT_SECRET=your_discord_oauth_client_secret
# Bootstrap only. Eternal Auth stores a PBKDF2 hash in D1 after first login.
ADMIN_PASSWORD=choose_a_long_random_admin_password
LICENSE_KEY_SECRET=generate_another_long_random_secret
HWID_PEPPER=generate_another_long_random_secret
CONFIG_SECRET=generate_a_long_random_secret_for_encrypted_config
# Origin of the running ShadowVM obfuscator (app.py). Every script uploaded or
# replaced through the dashboard is POSTed to OBFUSCATOR_URL/api/obfuscate and
# the obfuscated result is what gets stored and served. Required for uploads.
OBFUSCATOR_URL=https://your-obfuscator-host.example.com
# Optional JSON of obfuscation options; omit to use the obfuscator's defaults.
# OBFUSCATOR_SETTINGS={"vm_strength":10,"layers":2}
